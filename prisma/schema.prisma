generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model users {
  id    Int    @id @default(autoincrement())
  name  String @db.VarChar(100)
  email String @unique @db.VarChar(255)
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(200)
  content   String
  createdAt DateTime @default(now())
}
